####### Install

install_target: all 
	@$(CHK_DIR_EXISTS) "$(INSTALL_ROOT)/usr/local/bin/" || $(MKDIR) "$(INSTALL_ROOT)/usr/local/bin/"
	-$(INSTALL_FILE) "$(QMAKE_TARGET)" "$(INSTALL_ROOT)/usr/local/bin/$(QMAKE_TARGET)"

uninstall_target: 
	-$(DEL_FILE) "$(INSTALL_ROOT)/usr/local/bin/$(QMAKE_TARGET)"
	-$(DEL_DIR) "$(INSTALL_ROOT)/usr/local/bin/"


install_translation: all 
	@$(CHK_DIR_EXISTS) "$(INSTALL_ROOT)lang/" || $(MKDIR) "$(INSTALL_ROOT)lang/"
	-$(INSTALL_FILE) "lang/en-US.json" "$(INSTALL_ROOT)lang/"
	-$(INSTALL_FILE) "lang/zh-CN.json" "$(INSTALL_ROOT)lang/"
	-$(INSTALL_FILE) "lang/zh-TW.json" "$(INSTALL_ROOT)lang/"


uninstall_translation: 
	-$(DEL_FILE) -r "$(INSTALL_ROOT)lang/en-US.json"
	-$(DEL_FILE) -r "$(INSTALL_ROOT)lang/zh-CN.json"
	-$(DEL_FILE) -r "$(INSTALL_ROOT)lang/zh-TW.json"
	-$(DEL_DIR) "$(INSTALL_ROOT)lang/"


install: install_target install_translation  

uninstall: uninstall_target uninstall_translation  

